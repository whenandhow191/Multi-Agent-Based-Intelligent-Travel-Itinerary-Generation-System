# Runtime profile
APP_ENV=development
DEBUG=false
MOCK_MODE=true

# Local services
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/travel_agent
POSTGRES_DB=travel_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
WEB_PORT=5173

# Server-side provider credentials (leave empty until the related checkpoint)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
AMAP_WEB_SERVICE_KEY=
QWEATHER_API_KEY=

# Browser-visible map key; use a separate least-privilege key with a domain allowlist
AMAP_JS_KEY=

# Local model runtime (no API key required)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
